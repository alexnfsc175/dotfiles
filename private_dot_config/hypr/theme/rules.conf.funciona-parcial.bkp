#windowrule = match:float true, match:class ^(nemo)$ && title:^(.*Properties.*)$

# Layer Rules
# Nota: Esses erros geralmente desaparecem após corrigir as windowrules acima.
layerrule = animation popin, match:namespace rofi
layerrule = blur true, match:namespace rofi
layerrule = ignore_zero true, match:namespace rofi

layerrule = blur true, match:namespace waybar
layerrule = ignorezero true, match:namespace waybar

layerrule = ignorezero true, match:namespace swaync-notification-window
layerrule = animation slide, match:namespace swaync-notification-window
layerrule = animation slide, match:namespace swaync-control-center

layerrule = animation fade, match:namespace swayosd

layerrule = animation fade, match:namespace selection
layerrule = animation fade, match:namespace hyprlock

layerrule = no_anim true, match:namespace hyprpicker
